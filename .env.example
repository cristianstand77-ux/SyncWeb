# Copie este arquivo para ".env" e preencha. O .env NÃO vai para o git.

# --- Django ---
# gere uma chave com:  python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=www.seudominio.com.br,seudominio.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=https://www.seudominio.com.br,https://seudominio.com.br

# --- Dados da empresa (aparecem no site) ---
# WhatsApp com DDI + DDD, só números
EMPRESA_WHATSAPP=5511999999999
EMPRESA_EMAIL=contato@seudominio.com.br
EMPRESA_CNPJ=00.000.000/0000-00
EMPRESA_RAZAO_SOCIAL=
EMPRESA_HORARIO=Segunda a sexta, das 9h às 18h
EMPRESA_INSTAGRAM=https://www.instagram.com/seuperfil
EMPRESA_LINKEDIN=https://www.linkedin.com/company/suaempresa

# --- Aviso de novo pedido por e-mail ---
# quem recebe (separe com vírgula). Vazio = ninguém recebe, mas o pedido fica salvo no admin.
CONTATO_DESTINATARIOS=contato@seudominio.com.br
DEFAULT_FROM_EMAIL=SyncWeb <nao-responda@seudominio.com.br>
# SMTP (deixe EMAIL_HOST vazio para os e-mails aparecerem só no terminal)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --- Estatísticas sem cookies (opcional) ---
PLAUSIBLE_DOMAIN=
